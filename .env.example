# ============================================================================
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ============================================================================

# ── Who receives booking notifications ──────────────────────────────────────
OWNER_EMAIL=artemijstepanov@gmail.com

# ── Resend (the only e-mail sender) ─────────────────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Sender address. Must be on a domain verified at https://resend.com/domains —
# until then Resend only delivers to the address that owns the Resend account,
# so student confirmation e-mails will bounce.
FROM_EMAIL=onboarding@resend.dev

# ── Branding used in e-mails ────────────────────────────────────────────────
BRAND_NAME=neko art platform
PUBLIC_PHONE=+370 624 50896
PUBLIC_SITE_URL=https://napdj.com

# ── Admin panel (/admin) ────────────────────────────────────────────────────
# Generate the hash with:  npm run admin:password -- "your password"
# Then paste the printed line here. Leave both values empty to keep the
# admin area completely locked.
ADMIN_PASSWORD_HASH=
# Plain-text alternative — only for local testing, prefer the hash above.
# ADMIN_PASSWORD=

# Random string used to sign admin session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=
# How long a login stays valid, in hours (default 8).
ADMIN_SESSION_HOURS=8

# ── Storage ─────────────────────────────────────────────────────────────────
# Supabase (free tier) — REQUIRED in production. Vercel's filesystem is
# temporary, so without these the reservation history disappears whenever a
# serverless instance recycles.
#   1. Create a project at https://supabase.com
#   2. SQL Editor → run supabase/schema.sql from this repo
#   3. Project Settings → API → copy the values below
# The service_role key must stay server-side only. Never put it in the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_TABLE=bookings

# Used only when Supabase is not configured: where bookings.json is written.
# DATA_DIR=/var/lib/nekoart

# ── Local API port ──────────────────────────────────────────────────────────
API_PORT=3001
